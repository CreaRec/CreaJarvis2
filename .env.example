OPENAI_API_KEY=sk-...
DATABASE_URL=postgres://jarvis:jarvis@postgres:5432/jarvis
# Agent rolling context (Telegram). Compose sets redis://redis:6379 for core.
REDIS_URL=redis://redis:6379
# AGENT_SESSION_TTL_SECONDS=0
# AGENT_SESSION_MAX_MESSAGES=10
# Production compose (server .env); local override builds from Dockerfile instead
# IMAGE=ghcr.io/crearec/crea-jarvis2
# IMAGE_TAG=main
# POSTGRES_USER=jarvis
# POSTGRES_PASSWORD=jarvis
# POSTGRES_DB=jarvis
# Host publish for Mac tools (container stays :5432). Default 5433 avoids trip-planner on 5432.
# POSTGRES_PORT=5433
JARVIS_GATEWAY_TOKEN=change-me-lan-token
BRAVE_API_KEY=
BRAVE_COUNTRY=US
BRAVE_SEARCH_LANG=ru
GOOGLE_PLACES_API_KEY=
USER_TIMEZONE=America/Chicago
# Optional overrides (defaults in src/config.ts):
# PORT=8787
# MEMORY_RETRIEVER=pgvector
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# REALTIME_MODEL=gpt-realtime-2.1
# AGENT_CHAT_MODEL=gpt-4o
# VOICE=marin
# VOICE_GATEWAY_URL=ws://127.0.0.1:8787/voice
REMINDER_MORNING_HOUR=10
REMINDER_AFTERNOON_HOUR=14
REMINDER_EVENING_HOUR=18
REMINDER_NIGHT_HOUR=21
REMINDER_QUIET_START=22
REMINDER_QUIET_END=8
REMINDER_POLL_MS=15000
# Household weather for orb / future voice (Open-Meteo on Core)
JARVIS_WEATHER=1
JARVIS_WEATHER_LAT=
JARVIS_WEATHER_LON=
JARVIS_WEATHER_PLACE=
JARVIS_WEATHER_TIMEOUT=3
# Apple Calendar (iCloud CalDAV) — leave all empty to disable
# Create an app-specific password at appleid.apple.com; set CALENDAR_URL to the
# target calendar href from CalDAV fetchCalendars() (https://caldav.icloud.com/...)
ICLOUD_CALDAV_USERNAME=
ICLOUD_CALDAV_PASSWORD=
ICLOUD_CALDAV_CALENDAR_URL=
# OpenTelemetry → Alloy (CreaGrafana). Containers on Docker network `lgtm`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_SERVICE_NAME=crea-jarvis
OTEL_SERVICE_NAMESPACE=apps
DEPLOY_ENV=production
# OTEL_SERVICE_VERSION=sha-...

# Telegram bot sidecar (Telegraf → Core /internal/agent/turn). Allowlist in data/telegram-bot/users.json
# TELEGRAM_IMAGE=ghcr.io/crearec/crea-jarvis2-telegram
# TELEGRAM_IMAGE_TAG=main
# TELEGRAM_BOT_TOKEN=
# STT_MODEL=whisper-1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin

# ESP syslog LAN bridge (Voice PE → UDP → OTLP). Image: ghcr.io/crearec/crea-jarvis2-esp-syslog
# BRIDGE_IMAGE=ghcr.io/crearec/crea-jarvis2-esp-syslog
# BRIDGE_IMAGE_TAG=main
# Host UDP port PE reaches (LAN IP of this host, e.g. 192.168.1.135:1514)
# SYSLOG_UDP_PORT=1514
