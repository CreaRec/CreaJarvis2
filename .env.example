OPENAI_API_KEY=sk-...
DATABASE_URL=postgres://jarvis:jarvis@postgres:5432/jarvis
PORT=8787
MEMORY_RETRIEVER=pgvector
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
REALTIME_MODEL=gpt-realtime-2.1
VOICE=marin
VOICE_GATEWAY_URL=ws://127.0.0.1:8787/voice
JARVIS_GATEWAY_TOKEN=change-me-lan-token
BRAVE_API_KEY=
BRAVE_COUNTRY=US
BRAVE_SEARCH_LANG=ru
GOOGLE_PLACES_API_KEY=
USER_TIMEZONE=America/Chicago
REMINDER_MORNING_HOUR=10
REMINDER_AFTERNOON_HOUR=14
REMINDER_EVENING_HOUR=18
REMINDER_NIGHT_HOUR=21
REMINDER_QUIET_START=22
REMINDER_QUIET_END=8
REMINDER_POLL_MS=15000
# Household weather for orb / future voice (Open-Meteo on Core)
JARVIS_WEATHER=1
JARVIS_WEATHER_LAT=
JARVIS_WEATHER_LON=
JARVIS_WEATHER_PLACE=
JARVIS_WEATHER_TIMEOUT=3
# Apple Calendar (iCloud CalDAV) — leave all empty to disable
# Create an app-specific password at appleid.apple.com; set CALENDAR_URL to the
# target calendar href from CalDAV fetchCalendars() (https://caldav.icloud.com/...)
ICLOUD_CALDAV_USERNAME=
ICLOUD_CALDAV_PASSWORD=
ICLOUD_CALDAV_CALENDAR_URL=
