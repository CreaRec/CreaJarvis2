generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemoryBranch {
  user
  directives
  world
}

enum MemoryConfidence {
  high
  medium
  assumption
}

enum MemorySensitivity {
  normal
  private
}

model Fact {
  id          String            @id @default(uuid()) @db.Uuid
  branch      MemoryBranch
  topic       String            @default("")
  text        String
  confidence  MemoryConfidence  @default(medium)
  sensitivity MemorySensitivity @default(normal)
  source      String            @default("")
  contentHash String            @unique
  active      Boolean           @default(true)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branch, active])
  @@index([topic])
  @@map("facts")
}

model Meta {
  key   String @id
  value String

  @@map("meta")
}

enum ReminderStatus {
  pending
  delivering
  delivered
  missed
  cancelled
  snoozed
}

model Reminder {
  id                   String         @id @default(uuid()) @db.Uuid
  text                 String
  fireAt               DateTime
  timezone             String
  status               ReminderStatus @default(pending)
  rawUtterance         String?
  recurrence           Json?
  quietHoursOverride   Boolean?
  deliveredAt          DateTime?
  embedding            Unsupported("vector(1536)")?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status, fireAt])
  @@index([fireAt])
  @@map("reminders")
}

enum PlanItemStatus {
  open
  done
  cancelled
}

model DayPlan {
  id        String     @id @default(uuid()) @db.Uuid
  localDate String
  timezone  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     PlanItem[]

  @@unique([localDate])
  @@map("day_plans")
}

model PlanItem {
  id           String         @id @default(uuid()) @db.Uuid
  planId       String         @db.Uuid
  plan         DayPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  text         String
  status       PlanItemStatus @default(open)
  sortOrder    Int            @default(0)
  scheduledAt  DateTime?
  reminderId   String?        @db.Uuid
  recurrence   Json?
  rawUtterance String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([planId, status, sortOrder])
  @@index([scheduledAt])
  @@map("plan_items")
}

enum ThemeKind {
  idea
  project
  trip
}

enum ThemeStatus {
  active
  on_hold
  done
  archived
}

enum ThemeEntryKind {
  note
  question
  decision
  checklist
  link
}

enum ThemeEntryStatus {
  open
  done
  cancelled
}

model Theme {
  id            String      @id @default(uuid()) @db.Uuid
  kind          ThemeKind
  title         String
  status        ThemeStatus @default(active)
  summary       String?
  meta          Json?
  rawUtterance  String?
  embedding     Unsupported("vector(1536)")?
  lastTouchedAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  entries       ThemeEntry[]

  @@index([kind, status])
  @@index([lastTouchedAt])
  @@map("themes")
}

model ThemeEntry {
  id           String           @id @default(uuid()) @db.Uuid
  themeId      String           @db.Uuid
  theme        Theme            @relation(fields: [themeId], references: [id], onDelete: Cascade)
  kind         ThemeEntryKind   @default(note)
  status       ThemeEntryStatus @default(open)
  text         String
  rawUtterance String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([themeId, createdAt])
  @@map("theme_entries")
}
