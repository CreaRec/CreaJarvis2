generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemoryBranch {
  user
  directives
  world
}

enum MemoryConfidence {
  high
  medium
  assumption
}

enum MemorySensitivity {
  normal
  private
}

model Fact {
  id          String            @id @default(uuid()) @db.Uuid
  branch      MemoryBranch
  topic       String            @default("")
  text        String
  confidence  MemoryConfidence  @default(medium)
  sensitivity MemorySensitivity @default(normal)
  source      String            @default("")
  contentHash String            @unique
  active      Boolean           @default(true)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([branch, active])
  @@index([topic])
  @@map("facts")
}

model Meta {
  key   String @id
  value String

  @@map("meta")
}

enum ReminderAppleSyncStatus {
  pending
  synced
  failed
}

model Reminder {
  id              String                  @id @default(uuid()) @db.Uuid
  text            String
  fireAt          DateTime
  timezone        String
  rawUtterance    String?
  recurrence      Json?
  appleSyncStatus ReminderAppleSyncStatus @default(pending)
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([fireAt])
  @@index([appleSyncStatus, fireAt])
  @@map("reminders")
}

model Event {
  id                 String    @id @default(uuid()) @db.Uuid
  uid                String
  /// Empty string for master / non-recurring; RECURRENCE-ID value for exceptions.
  recurrenceId       String    @default("")
  href               String
  title              String
  startAt            DateTime
  endAt              DateTime
  timezone           String
  notes              String?
  alarmMinutesBefore Json?
  recurrenceRule     String?
  isAllDay           Boolean   @default(false)
  sourceUpdatedAt    DateTime?
  lastSeenSyncId     String?   @db.Uuid
  locationName       String?
  locationAddress    String?
  locationMapsUrl    String?
  locationLat        Float?
  locationLon        Float?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([uid, recurrenceId])
  @@index([href])
  @@index([startAt, endAt])
  @@index([lastSeenSyncId])
  @@map("events")
}

enum PlanItemStatus {
  open
  done
  cancelled
}

model DayPlan {
  id        String     @id @default(uuid()) @db.Uuid
  localDate String
  timezone  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     PlanItem[]

  @@unique([localDate])
  @@map("day_plans")
}

model PlanItem {
  id           String         @id @default(uuid()) @db.Uuid
  planId       String         @db.Uuid
  plan         DayPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  text         String
  status       PlanItemStatus @default(open)
  sortOrder    Int            @default(0)
  scheduledAt  DateTime?
  reminderId   String?        @db.Uuid
  recurrence   Json?
  rawUtterance String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([planId, status, sortOrder])
  @@index([scheduledAt])
  @@map("plan_items")
}

enum ThemeKind {
  idea
  project
  trip
  list
}

enum ThemeStatus {
  active
  on_hold
  done
  archived
}

enum ThemeEntryKind {
  note
  question
  decision
  checklist
  link
}

enum ThemeEntryStatus {
  open
  done
  cancelled
}

model Theme {
  id            String      @id @default(uuid()) @db.Uuid
  kind          ThemeKind
  title         String
  status        ThemeStatus @default(active)
  summary       String?
  meta          Json?
  rawUtterance  String?
  embedding     Unsupported("vector(1536)")?
  lastTouchedAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  entries       ThemeEntry[]

  @@index([kind, status])
  @@index([lastTouchedAt])
  @@map("themes")
}

model ThemeEntry {
  id           String           @id @default(uuid()) @db.Uuid
  themeId      String           @db.Uuid
  theme        Theme            @relation(fields: [themeId], references: [id], onDelete: Cascade)
  kind         ThemeEntryKind   @default(note)
  status       ThemeEntryStatus @default(open)
  text         String
  rawUtterance String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([themeId, createdAt])
  @@map("theme_entries")
}

enum DeviceKind {
  desktop
  pi
  esp
  other
}

enum DeviceRoom {
  master_bedroom
  master_bathroom
  kitchen_living
  garage
  office
  poker_room
  play_room
  kids_room
  kids_office
  guest_room
}

model Device {
  id          String      @id @db.Uuid
  displayName String
  room        DeviceRoom?
  purpose     String?
  kind        DeviceKind  @default(desktop)
  capsVoice   Boolean     @default(true)
  capsNotify  Boolean     @default(true)
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([archived, lastSeenAt])
  @@map("devices")
}
