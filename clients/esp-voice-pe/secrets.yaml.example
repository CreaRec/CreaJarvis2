# Copy to secrets.yaml (never commit). Used by jarvis-voice-pe.yaml

wifi_ssid: "YourWifi"
wifi_password: "YourWifiPassword"

# From HA ESPHome device encryption / Noise key (base64)
api_encryption_key: "REPLACE_WITH_NOISE_PSK"

ota_password: "change-me-ota"

# Deployed Core on debian-server (LAN). Not Tailscale 100.x — ESP has no Tailscale.
jarvis_gateway_url: "ws://192.168.1.135:8787/voice"

# Same host as Core; ESP syslog UDP → esp-syslog-bridge (:1514)
syslog_host: "192.168.1.135"

# Same household token as server .env JARVIS_GATEWAY_TOKEN
jarvis_gateway_token: "change-me-lan-token"

# Stable UUID v4 for this device (persist across flashes)
jarvis_device_id: "14805e37-9f59-42de-844c-72872d2eee4c"

jarvis_display_name: "Voice PE"
# ADR-006 room id
jarvis_room: "kitchen_living"
